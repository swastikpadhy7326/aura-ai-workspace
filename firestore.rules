rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net (default deny)
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt', 'lastLoginAt']) &&
        data.uid is string &&
        data.uid == request.auth.uid &&
        data.email is string &&
        data.displayName is string &&
        data.displayName.size() <= 100 &&
        data.role in ['user', 'engineer', 'admin', 'guest'] &&
        data.createdAt is string &&
        data.lastLoginAt is string;
    }

    function isValidSecurityLog(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'eventType', 'timestamp']) &&
        data.id is string &&
        data.userId == userId &&
        data.eventType in ['sign_in', 'sign_up', 'sign_out', 'password_reset_request', 'profile_update', 'failed_attempt'] &&
        data.timestamp is string;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // PII protection: never list all users
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming());
      allow delete: if isOwner(userId) && isValidId(userId);

      match /securityLogs/{logId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(logId) && isValidSecurityLog(incoming(), userId);
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(userId);
      }
    }
  }
}
